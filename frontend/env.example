# StockView Frontend Environment Variables
# Copy this file to .env.local and update with your deployed backend URL

# Backend API URL (replace with your Render deployment URL)
# For Vite, use VITE_API_URL (not REACT_APP_API_URL)
VITE_API_URL=http://localhost:8000

# Example for production:
# VITE_API_URL=https://your-backend.onrender.com
